 "findings": [
  {
   "id": "interface-drift",
   "severity": "info",
   "summary": "The landed market_head.py API differs from the interface announced in the team channel; this audit targets the landed code.",
   "detail": {
    "announced": [
     "market_summary(h, group, valid)",
     "build_head(arm, hidden=, ctx_dim=, seed=, device=)",
     "heads expose forward()",
     "zero-init on residual_weight/residual_bias",
     "MLPLOB.score_from_representation"
    ],
    "landed": [
     "market_context(h, codes, valid=, counts=, n_groups=)",
     "build_head(arm, represent_dim=80, width=16, context_hidden=64, scalar_hidden=156)",
     "heads expose delta(h, m) / delta(h) returning a residual only",
     "zero-init on Member.mix.weight (arm C) and layers[-1] (arm B)",
     "no score_from_representation; use represent() + final_layers[-1]"
    ]
   },
   "impact": "Any downstream code written against the announced names raises AttributeError/TypeError, not a silently wrong number."
  },
  {
   "id": "replay-split-unreachable",
   "severity": "medium",
   "file": "scripts/market_context.py",
   "line": 81,
   "summary": "split_of() accepts only train/validation, but the cache entry point defaults to --splits train,replay and builds cache/replay.",
   "lines_involved": {
    "guard": "81-83",
    "iterate": "368",
    "cache_path": "597",
    "cli_default": "646"
   },
   "evidence": "scripts/audit_market_pipeline.py probe 'split_guard': final -> ValueError: Unknown split 'final' (sealed window correctly unreachable), replay -> ValueError: Unknown split 'replay'.",
   "impact": "`market_context.py cache` with its default arguments cannot complete, so the replay cache the ten-window comparison needs is not produced by the documented command. Fix before t4 depends on it."
  },
  {
   "id": "nonfinite-guard-is-global",
   "severity": "low",
   "file": "modified_tlob/market_head.py",
   "line": 107,
   "summary": "market_context raises FloatingPointError when any row of h is non-finite, including rows the caller marked valid=False.",
   "detail": "The pipeline derives valid from bar history (effective_count >= min_history), not from finiteness, so one NaN representation returned by the frozen trunk aborts the entire timestamp table instead of dropping that row.",
   "impact": "No leakage or unfairness, but a crash where the caller would prefer an excluded row. Callers should pass valid & isfinite(h).all(1)."
  },
  {
   "id": "coverage-degenerate-without-counts",
   "severity": "low",
   "file": "modified_tlob/market_head.py",
   "line": 85,
   "summary": "counts=None makes the coverage denominator the number of rows present in h, so a caller that materialises only usable rows always sees coverage 1.0 and the third context channel carries no information.",
   "detail": "scripts/market_context.py:203-204 passes counts from the prediction universe, which is why the audited path is not degenerate.",
   "impact": "Silent feature loss if a future caller forgets counts."
  },
  {
   "id": "representation-noise-margin",
   "severity": "info",
   "summary": "The frozen trunk's own batching noise on the 80-dim representation is 8.34e-7 (1.2x under the gate) versus 1.6e-7 on the score.",
   "detail": "This is float32 GEMM blocking inside MLPLOB.forward_with_representation, not the market head: the head sees h that is extracted once. Any replay comparison across chunk sizes must use a >=1e-6 tolerance, never bitwise equality on the representation.",
   "impact": "Batch-size-dependent bits in the representation do not change the reported scores beyond 1.6e-7."
  },
  {
   "id": "trained-artifact-missing",
   "severity": "info",
   "summary": "runs/market-context-441d-s11/armC.pt and armC.state.json are absent, so the 'trained residual is non-zero' leg was measured on a 60-step proxy training run, not on the delivered head.",
   "impact": "Re-run --check zeroinit once the trained head lands; the step-0 identity and the gradient-at-step-0 (>0) are already proven on the real class."
  }
 ],
